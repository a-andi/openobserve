sudo tee /etc/syslog-ng/conf.d/openobserve.conf > /dev/null <<'EOF'
@include "scl.conf"

source s_network {
  udp(ip("0.0.0.0") port(514));
  tcp(ip("0.0.0.0") port(514));
};

destination d_openobserve {
  openobserve-log(
    url("http://103.96.146.152")
    port(5080)
    organization("default")
    stream("network_syslog")
    user("admin@domain.com")
    password("key saat | 64 ")
  );
};

log {
  source(s_network);
  destination(d_openobserve);
  flags(flow-control);
};
EOF


# upgrade syslog-ng
# 1. Simpan release signing key
wget -qO - https://ose-repo.syslog-ng.com/apt/syslog-ng-ose-pub.asc | sudo gpg --dearmor -o /etc/apt/keyrings/syslog-ng-ose.gpg

# 2. Tambahkan repo stable untuk Ubuntu 24.04 (noble)
echo "deb [signed-by=/etc/apt/keyrings/syslog-ng-ose.gpg] https://ose-repo.syslog-ng.com/apt/ stable ubuntu-noble" | sudo tee /etc/apt/sources.list.d/syslog-ng-ose.list

# 3. Update & upgrade
sudo apt update
sudo apt install -y syslog-ng-core syslog-ng-scl syslog-ng-mod-http

Setelah itu, cek versi lagi:

bash
syslog-ng -V | head -5

Pastikan sudah ≥ 4.5.0. Kalau sudah, lanjut cek syntax config kamu:

bash
sudo syslog-ng -s

Kalau bersih (tanpa Error parsing config), lanjut:

bash
sudo systemctl restart syslog-ng
sudo systemctl status syslog-ng

Lalu test kirim log:

bash
logger -n 127.0.0.1 -P 20514 -d "test dari syslog-ng"

# Cek apakah (IP Device) pernah mengirim log (cari di data yang sudah ada):

START=$(($(date -d '24 hours ago' +%s) * 1000000))
END=$(($(date +%s) * 1000000))

curl -s -u "nama login.com:PASSWORD_ASLI_KAMU" \
  -X POST "http://ip server:5080/api/default/_search" \
  -H "Content-Type: application/json" \
  -d "{
    \"query\": {
      \"sql\": \"SELECT * FROM network_syslog WHERE host='ip device' ORDER BY _timestamp DESC LIMIT 5\",
      \"start_time\": $START,
      \"end_time\": $END
    }
  }" | python3 -m json.tool

# Sekaligus cek breakdown semua host yang pernah tercatat (biar kelihatan gambaran lengkap, termasuk apakah ip device ada tapi dengan format berbeda):

curl -s -u "nama login.com:PASSWORD_ASLI_KAMU" \
  -X POST "http://ip server:5080/api/default/_search" \
  -H "Content-Type: application/json" \
  -d "{
    \"query\": {
      \"sql\": \"SELECT host, COUNT(*) as jumlah FROM network_syslog GROUP BY host\",
      \"start_time\": $START,
      \"end_time\": $END
    }
  }" | python3 -m json.tool
